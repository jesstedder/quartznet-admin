@model IEnumerable<QuartzAdmin.web.Models.InstanceModel>
@{
    ViewData["Title"] = "Instances";
}

<h2>Instances</h2>

<table>
    <tr>
        <th></th>
        <th>ID</th>
        <th>Name</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                <a asp-action="Edit" asp-route-id="@item.InstanceName">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.InstanceName">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.InstanceName">Delete</a>
            </td>
            <td>@item.InstanceID</td>
            <td>@item.InstanceName</td>
        </tr>
    }
</table>

<p>
    <a asp-action="Create">Create New</a>
</p>
